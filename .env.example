# Klucz do Claude API. Tylko po stronie serwera — nigdy w przeglądarce.
# Wygenerujesz go w konsoli: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Identyfikator modelu. Źródło: dokumentacja Anthropic, "Models overview",
# https://platform.claude.com/docs/en/about-claude/models/overview
# (sprawdzone 2026-10-07 — claude-sonnet-5-5 jest szybszy od claude-opus-5-5
# i kosztuje 2 USD za milion tokenów wejścia oraz 10 USD za milion wyjścia,
# wobec 4 i 20 USD u Opusa).
# Krótkie komunikaty i dwuakapitowy opis wyniku nie potrzebują Opusa,
# a na pokazie liczy się czas odpowiedzi.
# Zmiana tej zmiennej wystarczy, żeby przełączyć model bez ruszania kodu.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limit zapytań na adres IP w oknie czasowym — patrz README, sekcja o kosztach.
# To tylko bezpiecznik demo. Prawdziwy limit kosztów ustaw w konsoli Anthropic.
LIMIT_ZAPYTAN=20
LIMIT_OKNO_MINUT=60

# Domeny, z których wolno wołać /api — po przecinku, bez ukośnika na końcu.
# Hosting dokłada do tej listy własny adres automatycznie, więc lokalnie
# można zostawić puste. Bez tego ktoś mógłby wołać nasz endpoint ze swojej
# strony i generować treści na nasz rachunek.
ALLOWED_ORIGINS=https://autopilot-aktywacji-ro.vercel.app

# --- User.com (etap 4) ---
# Adres bazowy z Twoją subdomeną, z ukośnikiem na końcu.
# Dokumentacja: https://apidocs.user.com/get-started/basic-api-usage.html
USERCOM_BASE_URL=https://TWOJA-SUBDOMENA.user.com/api/public/

# 64-znakowy klucz: Settings -> Workspace settings -> API & Integrations -> Public API
USERCOM_TOKEN=<64-znakowy-klucz-z-panelu>

# Tryb bezpieczny. Tylko dosłowne "false" włącza prawdziwe wywołania do User.com.
# Nawet wtedy kampanie powstają jako szkic — wysyłkę uruchamia człowiek w panelu.
DRY_RUN=true

# --- Źródło danych (etap 5) ---
# csv      — pliki w repozytorium (data/*.csv). DOMYŚLNE, działa bez konfiguracji.
# sheets   — publiczny arkusz Google, wymaga SHEET_ID poniżej.
# bigquery — szkielet docelowy; na razie mówi, czego potrzebuje, i nie udaje, że działa.
DATA_SOURCE=csv

# Identyfikator arkusza z adresu: docs.google.com/spreadsheets/d/<TO_JEST_ID>/edit
# Arkusz musi być udostępniony jako "każdy z linkiem może wyświetlać".
SHEET_ID=

# Docelowo, dla źródła bigquery
BIGQUERY_PROJECT=
BIGQUERY_DATASET=

# --- Mail po rozstrzygnięciu testu (etap 12) ---
# Dostawca: Resend (darmowy plan: 3000 maili miesięcznie, 100 dziennie).
# Alternatywa: User.com, którego Locon już używa — wtedy mail idzie tą samą
# drogą co kampanie. Wybór należy do człowieka; oba przez ten sam interfejs.
RESEND_API_KEY=
MAIL_NADAWCA=autopilot@example.com
MAIL_ODBIORCY=
ADRES_PROTOTYPU=https://autopilot.oleksiakconsulting.com

# Podpis wywołań zadania cyklicznego. Gdy ustawiony, /api/cron-raport bez
# nagłówka Authorization odrzuca żądanie (podgląd ze strony działa dalej).
CRON_SECRET=

# --- Mapa bez aplikacji (etap 6) ---
# Gdy obie zmienne są ustawione, stan prośby idzie do Redisa i przeżywa
# restart funkcji. Gdy ich nie ma, wchodzi TRYB DEMO: stan w pamięci jednej
# instancji, a strona mówi o tym wprost. Dokłada je integracja Upstash
# z Vercel Marketplace — instrukcja w TODO-RAFAL.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Działania serwisowe ---
# Dopóki ta zmienna jest pusta, /api/mapa?akcja=wyzeruj-liczniki jest WYŁĄCZONE
# i zwraca 503. Ustaw ją tylko na czas sprzątania po testach, potem usuń.
MAINTENANCE_TOKEN=
